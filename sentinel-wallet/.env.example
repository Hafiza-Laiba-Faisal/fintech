# Sentinel Wallet Environment Variables Template
# Copy this file to .env and fill in your values

# Account / Owner Configuration
OWNER_ADDRESS=0xYourOwnerAddressHere
OWNER_PRIVATE_KEY=0xYourPrivateKeyHere
GUARDIAN_ADDRESS=0xYourGuardianAddressHere
APPROVED_RECIPIENT=0xE06D8999DCfc16366A7A1C0189C22Bb9521940db

# Network & RPC
RPC_URL=https://sepolia.base.org
BUNDLER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=your_pimlico_api_key

# Optional Deployed Safe Address (set after deploy)
EXISTING_WALLET_ADDRESS=0x6cDE0BB1A5fb957d0e55c6E2dcd0a466c06D5123

# LLM Planner Configuration (Mini-FreeLLM local router)
LLM_ENDPOINT_URL=http://localhost:3001/v1/chat/completions
LLM_MODEL=auto
LLM_API_KEY=mfa-165f5cf8d64f6d667bea6aee264d0cf76144cdbc9a064c7d
LLM_FORMAT=openai
