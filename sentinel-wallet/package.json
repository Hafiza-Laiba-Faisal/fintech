{
  "name": "sentinel-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Sentinel Wallet — policy-governed AI agent wallet for FinTechathon 2026 Topic F",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "demo:mock": "tsx src/demo.ts --mock",
    "demo:llm": "tsx src/demo.ts --mock --llm",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:onchain": "node node_modules/tsx/dist/cli.mjs scripts/verify-onchain.ts",
    "live:test": "node node_modules/tsx/dist/cli.mjs scripts/live-test.ts",
    "generate:wallet": "node node_modules/tsx/dist/cli.mjs scripts/generate-wallet.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@smartagentkit/sdk": "^0.1.10",
    "@smartagentkit/testing": "^0.1.10",
    "viem": "^2.46.0",
    "dotenv": "^16.4.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
